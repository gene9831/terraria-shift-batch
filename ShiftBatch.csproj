<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>ShiftBatch</AssemblyName>
    <RootNamespace>ShiftBatch</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TerrariaPath Condition="'$(TerrariaPath)' == ''">D:\SteamLibrary\steamapps\common\Terraria</TerrariaPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <Reference Include="Terraria"><HintPath>$(TerrariaPath)\Terraria.exe</HintPath><Private>false</Private></Reference>
    <Reference Include="TerrariaModder.Core"><HintPath>$(TerrariaPath)\TerrariaModder\core\TerrariaModder.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(TerrariaPath)\TerrariaModder\core\deps\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework"><HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework.Game"><HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics"><HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
